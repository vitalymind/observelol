# GitHub
GITHUB_OWNER=<github_profile_name>
GITHUB_REPO=<github_repo_name>

# Google  cloud APIs
GCP_REQUIRED_APIS="[
	iam.googleapis.com,
	iamcredentials.googleapis.com,
	storage.googleapis.com,
	compute.googleapis.com,
	artifactregistry.googleapis.com,
	sts.googleapis.com,
	cloudresourcemanager.googleapis.com
]"

# Google cloud project
GCP_PROJECT_ID=<gcp_project_name>
GCP_PROJECT_NUMBER=<gcp_project_number>
GCP_REGION=<prefered_region>
GCP_STATE_BUCKET_NAME=<unique_name_for_service_bucket>

# Workload identity federation, deployment SA
GCP_WORKLOAD_IDENTITY_POOL=github-pool
GCP_WORKLOAD_IDENTITY_PROVIDER=github-provider
GCP_DEPLOY_SA_NAME=github-deployer
